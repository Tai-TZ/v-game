# Copy to .env for local overrides. No secrets belong in this file.

# Runtime environment: development | test | production
# (production disables /docs, /redoc and /openapi.json)
ENV=development

# Comma-separated browser origins allowed to call the API (no "*").
CORS_ORIGINS=http://localhost:5173

# --- Engine (v0.2) ---------------------------------------------------------------------
# Gemini key for real runs. Leave unset to start without an LLM: POST /api/runs then answers
# 503 "Chưa cấu hình LLM…". Put the real value only in backend/.env (gitignored), never here.
# GEMINI_API_KEY=
# Primary model (gemini-3.8-flash answered only 429/503/504 for the pilot key; see
# docs/design/engine-v0.2.md §14). Changing it means re-checking the star token budgets.
# GEMINI_MODEL=gemini-3.5-flash-lite
# Tried in order when a model answers 429/503 or is busy (empty = no fallback). Keep only models
# that accept the engine's thinking_level (gemini-2.5-flash answers 400 "Thinking level is not
# supported"); gemini-3.7-flash is out too (504, then no answer within 20 s). Star 2 is calibrated
# on the primary only: run.finished.models shows when a fallback served.
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
# Requests per minute per model, merged over the free-tier defaults in engine/llm.py
# (3.5-flash-lite and 3.1-flash-lite 15; 3.8-flash, 3.5-flash, 3.7-flash, 2.5-flash 5).
# One L3 run makes 13 calls: about one run per minute stays on the primary.
# GEMINI_RPM=gemini-3.5-flash-lite=15,gemini-3.1-flash-lite=15

# Server-wide cap on real (non-replayed) Gemini calls per UTC day, every model of the chain
# and every attempt included; protects the key. 500 / 13 calls = about 38 fresh runs a day.
# Render free pins 200 in render.yaml. The replay seed (reference and starter graphs) and the
# replay cache cost no call.
# DAILY_LLM_CALL_CAP=500
# Runs allowed at the same time (each run has up to 13 cases, 3 in parallel, so at most
# 3 x MAX_CONCURRENT_RUNS Gemini calls in flight). Raise once the key's RPM tier is known. The
# API loads no ML model (~130 MB RAM): rerank scores come from the shipped table.
# MAX_CONCURRENT_RUNS=1

# Index, question vectors and rerank scores. Default: the shipped src/vgame/engine/data/index,
# rebuilt by `uv run vgame-build-index` and committed.
# INDEX_DIR=
# Model files (vgame-build-index and slow tests only) and the replay cache (gitignored).
# Default: backend/.cache/engine
# ENGINE_CACHE_DIR=
# Corpus + golden files (read-only). Default: <repo>/docs/content
# CONTENT_DIR=
# EMBED_MODEL=intfloat/multilingual-e5-large
# RERANK_MODEL=jinaai/jina-reranker-v2-base-multilingual
