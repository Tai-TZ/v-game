# Copy to .env for local overrides. No secrets belong in this file.

# Runtime environment: development | test | production
# (production disables /docs, /redoc and /openapi.json)
ENV=development

# Comma-separated browser origins allowed to call the API (no "*").
CORS_ORIGINS=http://localhost:5173

# --- Engine (v0.2) ---------------------------------------------------------------------
# Gemini key for real runs. Leave unset to start without an LLM: POST /api/runs then answers
# 503 "Chưa cấu hình LLM…". Put the real value only in backend/.env (gitignored), never here.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Server-wide cap on real (non-replayed) Gemini calls per UTC day; protects the key.
# DAILY_LLM_CALL_CAP=500
# Runs allowed at the same time (each run has up to 13 cases, 3 in parallel, so at most
# 3 x MAX_CONCURRENT_RUNS Gemini calls in flight). Raise once the key's RPM tier is known.
# MAX_CONCURRENT_RUNS=1

# Index variants, model files and the replay cache (gitignored). Default: backend/.cache/engine
# ENGINE_CACHE_DIR=
# Corpus + golden files (read-only). Default: <repo>/docs/content
# CONTENT_DIR=
# EMBED_MODEL=intfloat/multilingual-e5-large
# RERANK_MODEL=jinaai/jina-reranker-v2-base-multilingual
