{
 "id": "chunk-tuning",
 "version": 1,
 "zone": "library",
 "corpus": [
  "qcdt-2024",
  "qcdt-2019"
 ],
 "allowed_blocks": [
  "input",
  "output",
  "corpus",
  "chunker",
  "vector_search",
  "context_packer",
  "llm"
 ],
 "locked_nodes": [
  "q",
  "kb",
  "out"
 ],
 "param_limits": {
  "vector_search.top_k": {
   "ge": 1.0,
   "le": 10.0
  },
  "vector_search.score_threshold": {
   "ge": 0.0,
   "le": 0.9,
   "multiple_of": 0.05
  },
  "context_packer.token_budget": {
   "const": 3000
  },
  "context_packer.on_overflow": {
   "const": "cat_duoi"
  },
  "llm.profile": {
   "const": "can_bang"
  }
 },
 "prompt_cards": {
  "G1": "Chỉ dùng thông tin trong các đoạn tài liệu được đưa kèm.",
  "G2": "Sau mỗi ý, ghi mã đoạn đã dùng trong ngoặc vuông.",
  "G3": "Nếu các đoạn tài liệu không có câu trả lời, chỉ nói: «Quy chế hiện hành không có thông tin này.»",
  "G4": "Xưng «mình», gọi người hỏi là «bạn», giọng thân thiện.",
  "G5": "Luôn đưa ra câu trả lời hữu ích nhất có thể, kể cả khi phải suy đoán.",
  "G6": "Trả lời thật đầy đủ, càng chi tiết càng tốt."
 },
 "starter_graph": {
  "schema": 1,
  "nodes": [
   {
    "id": "q",
    "type": "input",
    "params": {}
   },
