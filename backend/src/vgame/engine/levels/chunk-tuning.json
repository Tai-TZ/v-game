    "params": {
     "top_k": 3,
     "score_threshold": 0
    }
   },
   {
    "id": "pk",
    "type": "context_packer",
    "params": {
     "token_budget": 3000,
     "on_overflow": "cat_duoi",
     "cite_ids": true
    }
   },
   {
    "id": "llm",
    "type": "llm",
    "params": {
     "profile": "can_bang",
     "system_prompt": "Chỉ dùng thông tin trong các đoạn tài liệu được đưa kèm.\nSau mỗi ý, ghi mã đoạn đã dùng trong ngoặc vuông.\nNếu các đoạn tài liệu không có câu trả lời, chỉ nói: «Quy chế hiện hành không có thông tin này.»"
    }
